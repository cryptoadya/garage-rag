# Only ask uses this key. Never commit .env.
OPENROUTER_API_KEY=
# Only openrouter/free or an explicit model ending in :free is accepted.
OPENROUTER_MODEL=openrouter/free
# Storage contains source text: keep it private.
GARAGE_RAG_INDEX=data/qdrant
# Optional writable local Hugging Face cache (first run downloads E5).
HF_HOME=.cache/huggingface
