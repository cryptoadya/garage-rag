# Only generation uses these keys. Never commit .env.
GARAGE_RAG_PROVIDER=groq
# Source-aware expansion: at most one call for missing corpus languages.
# Always retain the original query. Same-language questions need no translation.
GARAGE_RAG_TRANSLATE_QUERY=true
# Storage contains source text: keep it private.
GARAGE_RAG_INDEX=data/qdrant
# Optional writable local Hugging Face cache (first run downloads E5).
HF_HOME=.cache/huggingface

# Groq Cloud is the only LLM provider. Verify organization Billing shows Free/Current Plan.
# Attestation is required because Groq has no API zero-price cap. Keep false until verified.
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Includes reasoning; 512..4096. Conservative byte-bound quota reservation may stop early.
GROQ_MAX_TOKENS=2048
# Optional pinned offline tokenizer accounting; bytes preserves the default.
GROQ_TOKEN_ACCOUNTING=bytes
# Proactive quota wait per completion, 0..120 seconds. Longer cooldowns return 429.
GROQ_MAX_QUOTA_WAIT_SECONDS=65
