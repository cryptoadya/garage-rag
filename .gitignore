# Benchmark runs belong in /output/; /benchmarks/ holds versioned input datasets.
# Publish reviewed summaries and explicitly retained source-text-free results.
/docs/benchmarks/*.json
# Frozen public baselines must also remain available in source distributions.
!/docs/benchmarks/phase2a-baseline.v1.json
!/docs/benchmarks/phase2a-tire-audit.v1.json
!/docs/benchmarks/phase2b-results.v1.json
# Reviewed multilingual comparison evidence, also required in source distributions.
!/docs/benchmarks/multilingual-ru-en.v1.json
!/docs/benchmarks/multilingual-c3.v2.json
!/docs/benchmarks/multilingual-retrieval-performance.v1.json
